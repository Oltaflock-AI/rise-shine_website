# Copy to `.env.local` and fill in. `.env.local` is git-ignored — never commit real keys.

# ── Supabase (customer accounts) ──────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API.
# Both are safe to expose to the browser; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY, bypasses RLS. Needed later to write booking
# history from the TBO flow. Do NOT prefix with NEXT_PUBLIC_ and never ship to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── TBO (TekTravels) flight API ───────────────────────────────────────────────
# Agency creds (Authenticate → TokenId flow). Also reused by the hotel booking
# flow and the hotel post-booking (GetBookingDetail/Voucher/Cancel) calls.
TBO_CLIENT_ID=
TBO_USERNAME=
TBO_PASSWORD=
TBO_END_USER_IP=
#
# Service hosts. LIVE and STAGING are entirely different domains — switching
# environments means changing these, not just the credentials. Leave all three
# unset for staging. Live values issued by TBO on 2026-08-11 (ClientId tboprod):
#   TBO_AUTH_URL=https://api.travelboutiqueonline.com/SharedAPI/SharedData.svc/rest
#   TBO_SEARCH_URL=https://tboapi.travelboutiqueonline.com/AirAPI_V10/AirService.svc/rest
#   TBO_BOOK_URL=https://booking.travelboutiqueonline.com/AirAPI_V10/AirService.svc/rest
# Auth + Search/FareRule/FareQuote/SSR bases (no trailing method segment).
# TBO_AUTH_URL=
# TBO_SEARCH_URL=
# Book / Ticket / GetBookingDetails / SendChangeRequest / ReleasePNR.
# Setting this also disables the staging-only AirBook→Air fallback.
# TBO_BOOK_URL=

# ── TBO Hotel API — STATIC data (Basic auth, shared static-data creds) ────────
# Powers CountryList / CityList / TBOHotelCodeList / HotelDetails. These are the
# "static data credentials" TBO sent separately — NOT your agency login.
# Host per docs; override only if your creds email says otherwise.
TBO_HOTEL_STATIC_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI
TBO_HOTEL_STATIC_USERNAME=
TBO_HOTEL_STATIC_PASSWORD=

# ── TBO Hotel API — booking (Basic auth, your AGENCY creds) ───────────────────
# Powers Search / PreBook / Book. Agency creds = your flight login per TBO;
# Set USER/PASS explicitly — see the warning below.
# Host is contradictory in the docs (affiliate.tektravels.com vs tbotechnology) —
# confirmed by the Phase-1 smoke test; override here once known.
TBO_HOTEL_URL=https://affiliate.tektravels.com/HotelAPI
# SET THESE. They fall back to TBO_USERNAME/TBO_PASSWORD when unset, and that
# fallback breaks the moment the flight account moves to live: TBO's hotel hosts
# answer the flight login with 401 "Access Credentials is incorrect", which the
# site can only render as "no availability" for every city (outage, 18-Aug-2026).
TBO_HOTEL_USERNAME=
TBO_HOTEL_PASSWORD=

# ── TBO HotelBE post-booking auth (GetBookingDetail / Voucher / Cancel) ───────
# HotelBE needs a TokenId from the agency that OWNS the hotel bookings. That used
# to be the flight login, and stopped being it on 11-Aug-2026 when flights moved
# to production: a live token (agency 63641) presented to the certification
# HotelBE (agency 58394) is answered `ErrorCode 6 · Invalid Token`, which killed
# GetBookingDetail, GenerateVoucher and SendChangeRequest outright.
# Leave BLANK to fall back to the flight token (right again once both stacks are
# on one agency). Certification values: ClientId ApiIntegrationNew, username and
# password = the TBO_HOTEL_* pair above.
TBO_HOTEL_BE_AUTH_URL=http://Sharedapi.tektravels.com/SharedData.svc/rest
TBO_HOTEL_BE_CLIENT_ID=
# Default to TBO_HOTEL_USERNAME / TBO_HOTEL_PASSWORD when unset.
TBO_HOTEL_BE_USERNAME=
TBO_HOTEL_BE_PASSWORD=

# ── TBO portal-verification session (temporary, certification only) ────────────
# Lets TBO's verifier complete a hotel Book WITHOUT paying, by visiting
#   /api/hotels/verification?token=<this>
# It is inert unless the hotel hosts above are TBO certification hosts, so it can
# never give away a live room. Needed only because Cashfree went live for FLIGHTS
# (18-Aug-2026) while hotels stayed on certification, and the one global "keys
# present" flag then put a real payment page in the verifier's way.
# Unset = feature absent. DELETE this once hotel certification is signed off.
TBO_VERIFICATION_TOKEN=

# ── TBO static-IP egress proxy (needed once LIVE creds are issued) ─────────────
# TBO whitelists the caller's IP for production, but Vercel has no fixed egress
# IP — so every TBO call routes through this forward proxy when set. Format:
# http://user:pass@STATIC_IP:8888  (setup: reference/hotel-cert/static-ip-proxy/)
# Leave unset in dev/staging — calls go direct.
# TBO_PROXY_URL=

# ── Google Places (live reviews on the testimonial section) ───────────────────
# SERVER ONLY. From: Google Cloud Console → APIs & Services → Credentials.
# Enable "Places API" (legacy — allows newest-first review sort) and/or
# "Places API (New)" on the key's project; the code tries legacy first, then New.
# Without a key the site falls back to the static testimonials in src/data/.
GOOGLE_MAPS_API_KEY=
# Optional: pin the listing's Place ID to skip the text-search lookup.
# Find it: https://developers.google.com/maps/documentation/places/web-service/place-id
# GOOGLE_PLACE_ID=

# ── Cashfree Payments (checkout / payments) ──────────────────────────────────
# From: Cashfree Merchant Dashboard → Developers → API Keys.
#   https://merchant.cashfree.com/merchants/pg/developers/api-keys
# BOTH values are SERVER ONLY — never prefix either with NEXT_PUBLIC_ and never
# commit them. Cashfree has no publishable key: the browser opens checkout on a
# short-lived payment_session_id minted by /api/payment/order, so nothing secret
# ever reaches the client.
# With both set, payment is ENFORCED before any ticket or hotel booking is issued.
# CASHFREE_ENV also gates LIVE TBO: sandbox keys settle nothing, so live TBO hosts
# refuse to book until this is production (otherwise a real ticket is issued for
# play money). Sandbox keys + TBO certification hosts is the normal test setup.
# Without them, flights refuse to book and hotels fall back to the unpaid path —
# but ONLY on TBO's certification hosts (see src/lib/tbo-env.ts).
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# Which Cashfree stack the keys belong to. Accepts sandbox|test|dev or
# production|prod|live; anything else falls back to sandbox with a warning. This
# picks the API base URL AND the mode the browser SDK is initialised in — a sandbox
# payment_session_id will not open in a production SDK, so a mismatch fails at the
# popup with no useful error. Sandbox keys start cf_test_/TEST, live keys do not.
CASHFREE_ENV=sandbox
# Optional. Pinned API version (x-api-version); the code defaults to 2026-01-01,
# Cashfree's current version. Only change after reading the new version's schema —
# Cashfree returns different response shapes per version.
# Webhooks are versioned SEPARATELY: set the endpoint's version to 2026-01-01 in
# Dashboard -> Developers -> Webhooks so the two don't drift.
# CASHFREE_API_VERSION=2026-01-01
# Optional. Cashfree signs webhooks with CASHFREE_SECRET_KEY, so there is no second
# secret to configure — set this ONLY for a partner-key setup that signs differently.
# Webhook endpoint: /api/payment/webhook, configured in Dashboard → Developers →
# Webhooks with events PAYMENT_SUCCESS, PAYMENT_FAILED, PAYMENT_USER_DROPPED,
# REFUND_STATUS. Powers the reconciliation ledger (supabase/migrations/0007).
# CASHFREE_WEBHOOK_SECRET=

# ── Resend (transactional email) ──────────────────────────────────────────────
# From: resend.com → API Keys. With a key set, booking confirmations (flight PNR /
# hotel confirmation no.) and refund notices are emailed to the lead passenger.
# Without it, email is silently skipped — bookings are never blocked on email.
RESEND_API_KEY=
# Verified sender, e.g. "Rise & Shine Travels <info@riseandshinetravel.com>".
# Defaults to Resend's onboarding sender (testing only).
#
# Add the APEX riseandshinetravel.com in Resend and copy the record NAMES it
# shows verbatim. Resend scopes its own MX + SPF to send.riseandshinetravel.com
# by design, so the apex MX (Microsoft 365) and the apex SPF
# (`v=spf1 include:spf.protection.outlook.com -all`) are never touched. Do NOT
# hand-place Resend's MX or SPF at the apex: an MX record only affects the name
# it sits on, and a second one beside M365's would either take delivery of the
# company's mail or be ignored entirely, depending on priority.
#
# info@ is deliberate — it is a real M365 mailbox, so a customer who replies (or
# copies the From address by hand) reaches a human. lib/email.ts also sets
# reply_to from src/data/site.ts.
#
# Check it end to end with: npx tsx scripts/resend-domain-check.mts --send you@…
EMAIL_FROM=
# Origin used to build auth-email links (password reset) and unsubscribe URLs.
# Leave BLANK in normal use: links are then built from the incoming request, so a
# reset requested on localhost points at localhost and one from production points
# at production. This is the whole reason the site mints its own links instead of
# letting Supabase send them — Supabase has one Site URL for every environment,
# so its reset emails bounce you to production from your dev machine.
# Set it only for contexts with no request (a cron job, a script).
SITE_URL=
# Where ops alerts (failed refunds, post-capture booking failures) are sent.
# Defaults to the agency inbox in src/data/site.ts. Requires RESEND_API_KEY.
ALERT_EMAIL=
# Cron auth — the caller sends "Authorization: Bearer <CRON_SECRET>". Used by
# /api/cron/reconcile (Vercel Cron, weekly, see vercel.json) AND by
# /api/cron/callback-queue (external per-minute pinger, see below). Generate any
# long random string; without it BOTH cron routes refuse to run and return 503.
CRON_SECRET=
# ── ElevenLabs voice agent (outbound calls → /api/voice/webhook) ──────────────
# The post-call webhook secret ElevenLabs shows ONCE when you create the webhook
# (Conversational AI → Settings → Webhooks). Format: wsec_… . Without it the
# endpoint returns 503 and stores nothing. Point the webhook at
# https://riseand-shine-final-website.vercel.app/api/voice/webhook (the project's
# stable Vercel alias — no custom domain required) and enable
# post_call_transcription (+ optionally post_call_audio, call_initiation_failure).
ELEVENLABS_WEBHOOK_SECRET=
# Only accept events from OUR agent. The webhook is workspace-wide, so any other
# agent in the same ElevenLabs workspace would otherwise write into the voice_calls
# CRM. Unset = accept all agents. ALSO the agent used to PLACE calls (see below) —
# one value, both directions.
#
# Deliberately left blank. A literal id used to live here and in voice-agent/, and
# when the agent was recreated the stale value silently broke BOTH halves: outbound
# calls failed with "Document with id … not found", and the webhook dropped every
# real event as "other-agent" while returning 200. Copy the current id from
# ElevenLabs → Conversational AI → Agents → (the agent) rather than trusting a
# checked-in default.
ELEVENLABS_AGENT_ID=

# ── ElevenLabs — PLACING calls (/request-a-call → /api/cron/callback-queue) ───
# The webhook above only RECEIVES events, so it needs no API key. Dialling out
# does. Both of these are required (along with ELEVENLABS_AGENT_ID) or the
# dispatch route returns 503 and leads simply queue up unharmed.
# Key: elevenlabs.io → Profile → API Keys. ELEVEN_API works as an alias so one
# workspace key can serve this app and voice-agent/ alike.
ELEVENLABS_API_KEY=
# The SIP trunk number to call FROM: ElevenLabs → Conversational AI → Phone Numbers.
ELEVENLABS_PHONE_NUMBER_ID=
# Seconds to wait after form submission before ringing. Default 120; clamped
# 0…3600. Read per request, so changing it in Vercel applies without a redeploy —
# the wait quoted on the page updates itself to match.
VOICE_CALLBACK_DELAY_SECONDS=120
# NOTE: /api/cron/callback-queue is deliberately NOT in vercel.json. Vercel Cron
# on Hobby cannot run per-minute, which a ~2 minute callback needs, so schedule an
# external pinger (cron-job.org, UptimeRobot, GitHub Actions) to GET it every
# minute with the header `Authorization: Bearer $CRON_SECRET`.

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX) from GA Admin → Data
# Streams. Client-visible by design (NEXT_PUBLIC_). Unset = GA never loads.
# Funnel events sent: search, checkout_opened, payment_started, booking_confirmed.
NEXT_PUBLIC_GA_ID=
