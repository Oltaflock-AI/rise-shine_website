# Copy to `.env.local` and fill in. `.env.local` is git-ignored — never commit real keys.

# ── Supabase (customer accounts) ──────────────────────────────────────────────
# From: Supabase dashboard → Project Settings → API.
# Both are safe to expose to the browser; data is protected by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — SERVER ONLY, bypasses RLS. Needed later to write booking
# history from the TBO flow. Do NOT prefix with NEXT_PUBLIC_ and never ship to the client.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── TBO (TekTravels) flight API ───────────────────────────────────────────────
# Agency creds (Authenticate → TokenId flow). Also reused by the hotel booking
# flow and the hotel post-booking (GetBookingDetail/Voucher/Cancel) calls.
TBO_CLIENT_ID=
TBO_USERNAME=
TBO_PASSWORD=
TBO_END_USER_IP=
# Optional: override the Book/Ticket service URL if TBO provisions AirBook.
# TBO_BOOK_URL=

# ── TBO Hotel API — STATIC data (Basic auth, shared static-data creds) ────────
# Powers CountryList / CityList / TBOHotelCodeList / HotelDetails. These are the
# "static data credentials" TBO sent separately — NOT your agency login.
# Host per docs; override only if your creds email says otherwise.
TBO_HOTEL_STATIC_URL=http://api.tbotechnology.in/TBOHolidays_HotelAPI
TBO_HOTEL_STATIC_USERNAME=
TBO_HOTEL_STATIC_PASSWORD=

# ── TBO Hotel API — booking (Basic auth, your AGENCY creds) ───────────────────
# Powers Search / PreBook / Book. Agency creds = your flight login per TBO;
# leave USER/PASS blank to reuse TBO_USERNAME / TBO_PASSWORD, or set explicitly.
# Host is contradictory in the docs (affiliate.tektravels.com vs tbotechnology) —
# confirmed by the Phase-1 smoke test; override here once known.
TBO_HOTEL_URL=https://affiliate.tektravels.com/HotelAPI
# TBO_HOTEL_USERNAME=
# TBO_HOTEL_PASSWORD=

# ── TBO static-IP egress proxy (needed once LIVE creds are issued) ─────────────
# TBO whitelists the caller's IP for production, but Vercel has no fixed egress
# IP — so every TBO call routes through this forward proxy when set. Format:
# http://user:pass@STATIC_IP:8888  (setup: reference/hotel-cert/static-ip-proxy/)
# Leave unset in dev/staging — calls go direct.
# TBO_PROXY_URL=

# ── Google Places (live reviews on the testimonial section) ───────────────────
# SERVER ONLY. From: Google Cloud Console → APIs & Services → Credentials.
# Enable "Places API" (legacy — allows newest-first review sort) and/or
# "Places API (New)" on the key's project; the code tries legacy first, then New.
# Without a key the site falls back to the static testimonials in src/data/.
GOOGLE_MAPS_API_KEY=
# Optional: pin the listing's Place ID to skip the text-search lookup.
# Find it: https://developers.google.com/maps/documentation/places/web-service/place-id
# GOOGLE_PLACE_ID=

# ── Razorpay (checkout / payments) ────────────────────────────────────────────
# From: Razorpay Dashboard → Settings → API Keys → Generate Key. Use TEST keys
# (rzp_test_…) until go-live, then swap for LIVE keys (rzp_live_…).
# KEY_ID is handed to the browser to open Checkout; KEY_SECRET is SERVER ONLY —
# never prefix it with NEXT_PUBLIC_ and never commit it. With both set, payment is
# ENFORCED before any ticket is issued; without them, booking degrades to the
# legacy direct-ticket path (dev/staging only).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret — a SEPARATE secret you set in Dashboard → Settings → Webhooks when
# you add the /api/payment/webhook endpoint (events: payment.captured, payment.failed,
# refund.processed). Powers the reconciliation ledger; leave blank to disable webhooks.
RAZORPAY_WEBHOOK_SECRET=

# ── Resend (transactional email) ──────────────────────────────────────────────
# From: resend.com → API Keys. With a key set, booking confirmations (flight PNR /
# hotel confirmation no.) and refund notices are emailed to the lead passenger.
# Without it, email is silently skipped — bookings are never blocked on email.
RESEND_API_KEY=
# Verified sender, e.g. "Rise & Shine Travels <bookings@yourdomain.com>". Needs the
# domain verified in Resend; defaults to Resend's onboarding sender (testing only).
EMAIL_FROM=
# Where ops alerts (failed refunds, post-capture booking failures) are sent.
# Defaults to the agency inbox in src/data/site.ts. Requires RESEND_API_KEY.
ALERT_EMAIL=
# Cron auth — the caller sends "Authorization: Bearer <CRON_SECRET>". Used by
# /api/cron/reconcile (Vercel Cron, weekly, see vercel.json) AND by
# /api/cron/callback-queue (external per-minute pinger, see below). Generate any
# long random string; without it BOTH cron routes refuse to run and return 503.
CRON_SECRET=
# ── ElevenLabs voice agent (outbound calls → /api/voice/webhook) ──────────────
# The post-call webhook secret ElevenLabs shows ONCE when you create the webhook
# (Conversational AI → Settings → Webhooks). Format: wsec_… . Without it the
# endpoint returns 503 and stores nothing. Point the webhook at
# https://riseand-shine-final-website.vercel.app/api/voice/webhook (the project's
# stable Vercel alias — no custom domain required) and enable
# post_call_transcription (+ optionally post_call_audio, call_initiation_failure).
ELEVENLABS_WEBHOOK_SECRET=
# Optional but recommended: only accept events from OUR agent. The webhook is
# workspace-wide, so any other agent in the same ElevenLabs workspace would
# otherwise write into the voice_calls CRM. Unset = accept all agents.
# ALSO the agent used to PLACE calls (see below) — one value, both directions.
ELEVENLABS_AGENT_ID=agent_6901kth2msjxf0wtnxwwgpp9an03

# ── ElevenLabs — PLACING calls (/request-a-call → /api/cron/callback-queue) ───
# The webhook above only RECEIVES events, so it needs no API key. Dialling out
# does. Both of these are required (along with ELEVENLABS_AGENT_ID) or the
# dispatch route returns 503 and leads simply queue up unharmed.
# Key: elevenlabs.io → Profile → API Keys. ELEVEN_API works as an alias so one
# workspace key can serve this app and voice-agent/ alike.
ELEVENLABS_API_KEY=
# The SIP trunk number to call FROM: ElevenLabs → Conversational AI → Phone Numbers.
ELEVENLABS_PHONE_NUMBER_ID=
# Seconds to wait after form submission before ringing. Default 120; clamped
# 0…3600. Read per request, so changing it in Vercel applies without a redeploy —
# the wait quoted on the page updates itself to match.
VOICE_CALLBACK_DELAY_SECONDS=120
# NOTE: /api/cron/callback-queue is deliberately NOT in vercel.json. Vercel Cron
# on Hobby cannot run per-minute, which a ~2 minute callback needs, so schedule an
# external pinger (cron-job.org, UptimeRobot, GitHub Actions) to GET it every
# minute with the header `Authorization: Bearer $CRON_SECRET`.

# Google Analytics 4 — Measurement ID (G-XXXXXXXXXX) from GA Admin → Data
# Streams. Client-visible by design (NEXT_PUBLIC_). Unset = GA never loads.
# Funnel events sent: search, checkout_opened, payment_started, booking_confirmed.
NEXT_PUBLIC_GA_ID=
