{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "crons": [
    {
      "path": "/api/cron/healthcheck",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/callback-queue",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/reconcile",
      "schedule": "30 3 * * 1"
    },
    {
      "path": "/api/cron/settle-intents",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/hotel-static",
      "schedule": "30 21 * * *"
    }
  ]
}
